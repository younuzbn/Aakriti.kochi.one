# Aakriti API (the standalone Aakriti backend).
# Production: https://aakriti-api.kochi.one
# Local: API_BASE_URL=http://localhost:3020 (run the Aakriti backend on that port)
API_BASE_URL=https://aakriti-api.kochi.one
PORT=3021

# Optional. Defaults to API_BASE_URL + /aakriti-logo.png (file must exist under the backend's public/ folder).
# LOGO_URL=https://aakriti-api.kochi.one/aakriti-logo.png

# Staff/admin login page: https://aakriti.kochi.one/login -> uses the API for /api/aakriti/portal/*
